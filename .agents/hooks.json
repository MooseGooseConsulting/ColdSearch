{
  "entire": {
    "SessionStart": [
      {
        "type": "command",
        "command": "entire hooks antigravity session-start"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "entire hooks antigravity pre-tool-use"
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "entire hooks antigravity pre-invocation"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "entire hooks antigravity stop",
        "timeout": 300
      }
    ]
  }
}
