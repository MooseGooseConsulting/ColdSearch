{
  "entire": {
    "SessionStart": [
      {
        "type": "command",
        "command": "entire hooks antigravity session-start || exit 0"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "entire hooks antigravity pre-tool-use || exit 0"
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "entire hooks antigravity pre-invocation || exit 0"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "entire hooks antigravity stop || exit 0",
        "timeout": 300
      }
    ]
  }
}
